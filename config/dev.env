ENVIRONMENT=dev
AWS_REGION=eu-west-1
STACK_PREFIX=camedina

# github-oidc.yaml
GITHUB_ORG=Alpoh
GITHUB_INFRA_REPO=camedina-clients-infra
GITHUB_SERVICE_REPO=camedina-clients-services
GITHUB_FRONT_REPO=camedina-clients-front

# network.yaml
VPC_CIDR=10.0.0.0/16
PUBLIC_SUBNET_1_CIDR=10.0.0.0/24
PUBLIC_SUBNET_2_CIDR=10.0.1.0/24
PRIVATE_SUBNET_1_CIDR=10.0.10.0/24
PRIVATE_SUBNET_2_CIDR=10.0.11.0/24

# rds.yaml
DB_INSTANCE_CLASS=db.t3.micro
DB_ALLOCATED_STORAGE=20
DB_ENGINE_VERSION=16.14
DB_NAME=clients
DB_MULTI_AZ=false
DB_BACKUP_RETENTION_DAYS=1

# service-clients-service.yaml
CLIENTS_SERVICE_CONTAINER_PORT=8080
CLIENTS_SERVICE_CPU=256
CLIENTS_SERVICE_MEMORY=512
CLIENTS_SERVICE_DESIRED_COUNT=1
CLIENTS_SERVICE_IMAGE_TAG=latest

# service-clients-front.yaml
CLIENTS_FRONT_CONTAINER_PORT=3000
CLIENTS_FRONT_CPU=256
CLIENTS_FRONT_MEMORY=512
CLIENTS_FRONT_DESIRED_COUNT=1
CLIENTS_FRONT_HEALTH_CHECK_PATH=/
CLIENTS_FRONT_IMAGE_TAG=latest
